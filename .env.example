# agent-quality-lab — example configuration.
# Copy to `.env` and edit. EVERY value has a safe default: with an empty environment
# the agent runs the fully-offline, deterministic stack (scripted LLM + in-process fake
# telemetry) with no API key and no network.

# --- LLM engine -------------------------------------------------------------------------
# deterministic = rule-based offline engine (default); anthropic = real Claude (needs a key).
AQL_LLM_PROVIDER=deterministic
AQL_ANTHROPIC_MODEL=claude-opus-4-8
# Standard, un-prefixed name. Only read when AQL_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Telemetry transport (how the agent's tools reach the Go service) -------------------
# fake = in-process deterministic data (default); http = the Go microservice.
AQL_TRANSPORT=fake
AQL_TELEMETRY_BASE_URL=http://localhost:8080
AQL_REQUEST_TIMEOUT_S=10.0

# --- Agent budget (bounds the loop) -----------------------------------------------------
AQL_MAX_TOOL_STEPS=6
AQL_MAX_RETRIES=2

# --- Observability ----------------------------------------------------------------------
AQL_OTEL_ENABLED=false
OTEL_SERVICE_NAME=agent-quality-lab
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Logging ----------------------------------------------------------------------------
AQL_LOG_LEVEL=INFO
AQL_LOG_JSON=true
